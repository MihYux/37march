+.modal-head span { color: var(--accent); font-size: 11px; letter-spacing: .1em; }
+.modal-head h2 { margin: 3px 0 16px; }
+.modal-head button { border: 0; background: transparent; font-size: 20px; }
+.region-options { display: grid; gap: 8px; }
+.region-options > button { padding: 12px 14px; display: grid; grid-template-columns: 45px 1fr 22px; align-items: center; border: 1px solid var(--line); border-radius: 11px; background: #fff; text-align: left; }
+.region-options > button.active { border-color: #c4a3cf; background: #f7f1f8; }
+.region-options > button > b { color: var(--accent-dark); }
+.region-options > button > span { display: grid; font-weight: 700; }
+.region-options small { color: var(--muted); font-weight: 400; }
+.new-region { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--line); }
+.new-region h3 { margin-top: 0; }
+.new-region > button { margin-top: 14px; }
+.spin { animation: release-spin .8s linear infinite; }
+@keyframes release-spin { to { transform: rotate(360deg); } }
+
+@media (max-width: 1050px) {
+  .release-console { grid-template-columns: 82px minmax(0,1fr); }
+  .release-brand span, .release-sidebar nav button b, .release-sidebar nav button > span, .release-principle { display: none; }
+  .release-brand { padding-inline: 1px; }
+  .release-sidebar nav button { grid-template-columns: 1fr; justify-items: center; }
+  .release-sidebar nav button.active::before { left: -18px; }
+  .directive-layout { grid-template-columns: 1fr 1fr; }
+  .directive-layout > :nth-child(2) { grid-column: span 2; grid-row: 1; }
+  .path-grid { grid-template-columns: 1fr; }
+}
+@media (max-width: 760px) {
+  .release-console { display: block; height: 100%; overflow: hidden; }
+  .release-main { height: 100%; padding-bottom: 66px; }
+  .release-sidebar { position: fixed; z-index: 40; inset: auto 0 0; width: 100%; height: 66px; padding: 7px; border: 0; border-top: 1px solid var(--line); }
+  .release-brand { display: none; }
+  .release-sidebar nav { grid-template-columns: repeat(6,1fr); }
+  .release-sidebar nav button { height: 51px; padding: 0; }
+  .release-sidebar nav button.active::before { inset: auto 20% -7px; width: 60%; height: 3px; }
+  .release-topbar { padding: 0 15px; }
+  .release-context select { display: none; }
+  .release-content { padding: 28px 16px 100px; }
+  .release-grid.two, .release-grid.split, .metric-sections, .release-form, .directive-layout { grid-template-columns: 1fr; }
+  .directive-layout > :nth-child(2), .release-form .wide { grid-column: 1; grid-row: auto; }
+  .release-summary-strip { grid-template-columns: 1fr 1fr; }
+  .release-summary-strip div:nth-child(2) { border-right: 0; }
+  .release-summary-strip div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
+  .release-hero { align-items: start; gap: 20px; flex-direction: column; }
+  .release-status { width: 100%; padding: 18px 0 0; border: 0; border-top: 1px solid rgba(255,255,255,.2); }
+  .plan-upload { grid-template-columns: 46px 1fr; }
+  .plan-upload > button { grid-column: 1 / -1; width: 100%; }
+  .fact-row { grid-template-columns: 1fr; }
+  .experiment-stage { grid-template-columns: 1fr 1fr; }
+}
+
+
+/* Compact region context: operator identity is fixed by the local workspace. */
+.release-context {
+  display: flex;
+  align-items: center;
+}
+.release-context .context-select {
+  width: auto;
+  min-width: 190px;
+  height: 48px;
+  padding: 5px 12px 5px 7px;
+  gap: 10px;
+  border-color: #e4dce7;
+  border-radius: 14px;
+  background: #fbf9fc;
+  box-shadow: 0 1px 2px rgba(65, 45, 70, .03);
+}
+.release-context .context-select:hover {
+  border-color: #ccb9d2;
+  background: #f8f3fa;
+}
+.release-context .context-icon {
+  width: 36px;
+  height: 36px;
+  flex: 0 0 36px;
+  display: grid;
+  place-items: center;
+  border-radius: 10px;
+  color: var(--accent);
+  background: #f0e7f3;
+}
+.release-context .context-icon svg {
+  font-size: 18px;
+}
+.release-context .context-copy {
+  min-width: 0;
+  flex: 1;
+  display: flex;
+  align-items: baseline;
+  gap: 9px;
+  line-height: 1;
+  white-space: nowrap;
+}
+.release-context .context-copy small {
+  color: var(--muted);
+  font-size: 11px;
+  font-weight: 650;
+}
+.release-context .context-copy b {
+  overflow: hidden;
+  color: var(--ink);
+  font-size: 15px;
+  font-weight: 760;
+  text-overflow: ellipsis;
+}
+.release-context .context-arrow {
+  flex: 0 0 auto;
+  color: #9b8ca0;
+  font-size: 15px;
+}
+@media (max-width: 760px) {
+  .release-context .context-select {
+    min-width: 0;
+    max-width: 210px;
+  }
+  .release-context .context-copy small {
+    display: none;
+  }
+}
