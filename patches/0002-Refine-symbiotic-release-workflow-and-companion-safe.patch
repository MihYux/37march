+    tasks: [],
+    segments: [],
+    directives: [],
+    reviews: [],
+    experiments: [],
+    metrics: [],
+    evaluations: [],
+    optimizations: [],
+    bundles: [],
+    planSources: [],
+    planReleases: [],
+    aiDeliveries: [],
