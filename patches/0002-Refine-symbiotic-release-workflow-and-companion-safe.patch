+function parseMemoryRefinement(content) {
+  const cleaned = String(content ?? "")
+    .replace(/^```(?:json)?\s*/i, "")
+    .replace(/\s*```$/u, "")
+    .trim();
+  const parsed = JSON.parse(cleaned);
+  return Array.isArray(parsed) ? parsed : parsed.memories;
+}
