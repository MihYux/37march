+    title: title.slice(0, 160),
+    objective,
+    theme: theme.slice(0, 500),
+    narrative: findValue(["叙事方式", "叙事策略", "角色表达策略", "角色策略"]).slice(0, 1200),
+    timeWindow: findValue(["时间窗口", "发行时间", "活动时间", "上线时间"]).slice(0, 200),
+    facts,
+    declaredRegion,
+    sourceDocument: {
