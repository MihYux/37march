+.delivery-list svg { color: var(--good); }
+.delivery-list span { display: grid; }
+.delivery-list small { color: var(--muted); }
+.delivery-list em { color: var(--good); font-size: 12px; font-style: normal; }
+.optimization-intro {
+  padding: 28px 30px;
+  display: flex;
+  align-items: center;
+  gap: 18px;
+  border-radius: 16px;
+  color: #fff;
+  background: linear-gradient(120deg, #3b3240, #6e5576);
+}
+.optimization-intro svg { font-size: 48px; color: #d6bbdc; }
+.optimization-intro h2 { margin: 0; }
+.optimization-intro p { margin: 4px 0 0; color: rgba(255,255,255,.68); }
+
+@media (max-width: 760px) {
+  .release-sidebar nav { grid-template-columns: repeat(4, 1fr); }
+  .release-title-actions { align-items: stretch; flex-direction: column; }
+  .pipeline-progress { grid-template-columns: 1fr 1fr; }
+  .pipeline-progress > div:nth-child(2) { border-right: 0; }
